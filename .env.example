# Copy to .env and fill in (.env is gitignored — never commit real keys).
# Load before running the backend:  set -a; source .env; set +a; ./mvnw spring-boot:run

# Scaleway Object Storage API key (IAM > API keys), in the Project that owns the bucket.
S3_ACCESS_KEY=SCWXXXXXXXXXXXXXXXXX
S3_KEY=00000000-0000-0000-0000-000000000000
